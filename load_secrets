#!/usr/bin/env zsh
# load_secrets - Securely load secrets from Bitwarden
# Server: https://vault.i.cloudgenius.app
# Email: nilesh@cloudgeni.us
# Usage: source load_secrets [all|github|bird|mrsk]
#        or run specific functions after sourcing

# Source .zprofile in non-interactive shells to get bw in PATH
if [[ -z "$ZSH_SUBSHELL" ]] && [[ -z "$BASH_SUBSHELL" ]]; then
  if [[ -f "$HOME/.zprofile" ]]; then
    source "$HOME/.zprofile" 2>/dev/null
  elif [[ -f "$HOME/.zshrc" ]]; then
    source "$HOME/.zshrc" 2>/dev/null
  fi
fi

# Configure self-hosted Bitwarden server
bw config server https://vault.i.cloudgenius.app >/dev/null 2>&1

# Keychain service name for storing BW_SESSION
BW_KEYCHAIN_SERVICE="bitwarden-cli-session"
BW_KEYCHAIN_ACCOUNT="bw_session"

# Ensure Bitwarden CLI is available
if ! command -v bw &>/dev/null; then
  echo "Error: Bitwarden CLI (bw) is not installed" >&2
  echo "Install with: brew install bitwarden-cli" >&2
  return 1 2>/dev/null || exit 1
fi

# Store BW_SESSION in macOS Keychain
_bw_save_session() {
  local session="$1"
  if [[ -n "$session" ]]; then
    # Delete existing entry if present, then add new one
    security delete-generic-password -s "$BW_KEYCHAIN_SERVICE" -a "$BW_KEYCHAIN_ACCOUNT" 2>/dev/null
    security add-generic-password -s "$BW_KEYCHAIN_SERVICE" -a "$BW_KEYCHAIN_ACCOUNT" -w "$session"
  fi
}

# Retrieve BW_SESSION from macOS Keychain
_bw_get_session() {
  security find-generic-password -s "$BW_KEYCHAIN_SERVICE" -a "$BW_KEYCHAIN_ACCOUNT" -w 2>/dev/null
}

# Clear BW_SESSION from Keychain (useful if session expires)
bw_clear_session() {
  security delete-generic-password -s "$BW_KEYCHAIN_SERVICE" -a "$BW_KEYCHAIN_ACCOUNT" 2>/dev/null
  unset BW_SESSION
  echo "Bitwarden session cleared from Keychain" >&2
}

# Unlock Bitwarden vault if locked
unlock_bw_if_locked() {
  # Try to get session from Keychain if not in environment
  if [[ -z "$BW_SESSION" ]]; then
    export BW_SESSION="$(_bw_get_session)"
  fi

  # Check if session is valid
  if [[ -n "$BW_SESSION" ]] && bw unlock --check &>/dev/null; then
    return 0
  fi

  # Session invalid or missing, clear it
  unset BW_SESSION

  # Check vault status
  local bw_status
  bw_status="$(bw status 2>/dev/null | grep -o '"status":"[^"]*"' | cut -d'"' -f4)"

  case "$bw_status" in
    unauthenticated)
      echo "❌ Not logged in to Bitwarden" >&2
      echo "" >&2
      echo "🔑 Run this to log in:" >&2
      echo "   bw login nilesh@cloudgeni.us" >&2
      echo "" >&2
      return 1
      ;;
    locked)
      echo "🔓 Unlocking vault..." >&2
      export BW_SESSION="$(bw unlock --raw)"
      if [[ -z "$BW_SESSION" ]]; then
        echo "Error: Failed to unlock Bitwarden vault" >&2
        return 1
      fi
      # Save to Keychain for future sessions
      _bw_save_session "$BW_SESSION"
      echo "✓ Session saved to Keychain" >&2
      ;;
    unlocked)
      # Already unlocked, just need to get session
      export BW_SESSION="$(bw unlock --raw)"
      if [[ -n "$BW_SESSION" ]]; then
        _bw_save_session "$BW_SESSION"
        echo "✓ Session ready" >&2
      fi
      ;;
    *)
      echo "Bitwarden: Unknown status '$bw_status'" >&2
      return 1
      ;;
  esac
}

# Helper to get a secret from Bitwarden
# Usage: bw_get <item_name_or_id> [field]
# field defaults to "notes", can also be "password", "username", or custom field name
bw_get() {
  local item="$1"
  local field="${2:-notes}"

  if [[ -z "$item" ]]; then
    echo "Usage: bw_get <item_name_or_id> [field]" >&2
    return 1
  fi

  unlock_bw_if_locked || return 1

  case "$field" in
    notes|password|username)
      bw get "$field" "$item" 2>/dev/null
      ;;
    *)
      # Custom field
      bw get item "$item" 2>/dev/null | jq -r ".fields[] | select(.name==\"$field\") | .value"
      ;;
  esac
}

# Load GitHub credentials
load_github() {
  unlock_bw_if_locked || return 1

  # GitHub Personal Access Token (stored in Bitwarden notes)
  local -r github_pat_id='37fecffb-e59b-44c4-912f-72b4b9028279'
  local github_token
  github_token="$(bw get notes "$github_pat_id")"

  if [[ -n "$github_token" ]]; then
    export GITHUB_TOKEN="$github_token"
    echo "✓ GITHUB_TOKEN loaded" >&2
  else
    echo "✗ Failed to load GITHUB_TOKEN" >&2
    echo "  Check item ID: $github_pat_id in Bitwarden" >&2
  fi
}

# Load MRSK/Kamal registry credentials
load_mrsk() {
  unlock_bw_if_locked || return 1

  local mrsk_pass
  mrsk_pass="$(bw get notes MRSK_REGISTRY_PASSWORD)"

  if [[ -n "$mrsk_pass" ]]; then
    export MRSK_REGISTRY_PASSWORD="$mrsk_pass"
    echo "✓ MRSK_REGISTRY_PASSWORD loaded" >&2
  else
    echo "✗ Failed to load MRSK_REGISTRY_PASSWORD" >&2
  fi
}

# Load bird (X/Twitter CLI) credentials
# Bitwarden item should have:
#   - Custom field "AUTH_TOKEN"
#   - Custom field "CT0"
# Or store as secure note with format:
#   AUTH_TOKEN=xxx
#   CT0=xxx
load_bird() {
  unlock_bw_if_locked || return 1

  # Try to get from Bitwarden item named "bird-cli" or "twitter-cli"
  local item_name="bird-cli"
  local auth_token ct0

  # Method 1: Custom fields (preferred)
  auth_token="$(bw_get "$item_name" "AUTH_TOKEN")"
  ct0="$(bw_get "$item_name" "CT0")"

  # Method 2: If custom fields empty, try parsing from notes
  if [[ -z "$auth_token" || -z "$ct0" ]]; then
    local notes
    notes="$(bw get notes "$item_name" 2>/dev/null)"
    if [[ -n "$notes" ]]; then
      auth_token="$(echo "$notes" | grep -E '^AUTH_TOKEN=' | cut -d'=' -f2-)"
      ct0="$(echo "$notes" | grep -E '^CT0=' | cut -d'=' -f2-)"
    fi
  fi

  if [[ -n "$auth_token" && -n "$ct0" ]]; then
    export AUTH_TOKEN="$auth_token"
    export CT0="$ct0"
    echo "✓ Bird CLI credentials loaded (AUTH_TOKEN, CT0)" >&2
  else
    echo "✗ Failed to load bird CLI credentials" >&2
    echo "  Create a Bitwarden item named '$item_name' with:" >&2
    echo "  - Custom field 'AUTH_TOKEN' or" >&2
    echo "  - Notes containing AUTH_TOKEN=xxx and CT0=xxx" >&2
    return 1
  fi
}

# Load OpenClaw Gateway secrets
# Bitwarden item "openclaw-secrets" with custom fields:
#   TELEGRAM_BOT_TOKEN, SLACK_BOT_TOKEN, SLACK_APP_TOKEN,
#   OPENCLAW_GATEWAY_TOKEN, GEMINI_API_KEY, GOOGLE_PLACES_API_KEY,
#   XIAOMI_VACUUM_TOKEN, DIRIGERA_TOKEN, BRAVE_API_KEY
load_openclaw() {
  unlock_bw_if_locked || return 1

  local item_name="openclaw-secrets"
  local item_json
  # bw prints "value=..." lines for hidden fields; filter them out
  item_json="$(bw get item "$item_name" 2>/dev/null | grep -v '^value=')"

  if [[ -z "$item_json" ]] || ! echo "$item_json" | jq -e . >/dev/null 2>&1; then
    echo "✗ Failed to fetch $item_name from Bitwarden" >&2
    return 1
  fi

  local fields=(
    TELEGRAM_BOT_TOKEN
    SLACK_BOT_TOKEN
    SLACK_APP_TOKEN
    OPENCLAW_GATEWAY_TOKEN
    GEMINI_API_KEY
    GOOGLE_PLACES_API_KEY
    XIAOMI_VACUUM_TOKEN
    DIRIGERA_TOKEN
    BRAVE_API_KEY
  )
  local loaded=0 failed=0

  for field in "${fields[@]}"; do
    local value
    value="$(echo "$item_json" | jq -r ".fields[] | select(.name==\"$field\") | .value")"
    if [[ -n "$value" && "$value" != "null" ]]; then
      export "$field"="$value"
      ((loaded++))
    else
      echo "✗ Failed to load $field" >&2
      ((failed++))
    fi
  done

  if [[ $failed -eq 0 ]]; then
    echo "✓ OpenClaw secrets loaded ($loaded vars)" >&2
  else
    echo "⚠ OpenClaw secrets partially loaded ($loaded ok, $failed failed)" >&2
    return 1
  fi
}

# Load all secrets
load_all() {
  echo "🔐 Loading secrets from Bitwarden..." >&2
  echo "   Server: https://vault.i.cloudgenius.app" >&2
  echo "   User: nilesh@cloudgeni.us" >&2
  echo "" >&2
  unlock_bw_if_locked || return 1
  load_github
  load_mrsk
  load_bird
  load_openclaw
  echo "" >&2
  echo "✅ Done." >&2
}

# Main: handle command line arguments
case "${1:-}" in
  all)      load_all ;;
  github)   load_github ;;
  bird)     load_bird ;;
  mrsk)     load_mrsk ;;
  openclaw) load_openclaw ;;
  "")       ;; # Just source the file, don't load anything
  *)
    echo "❌ Unknown option: $1" >&2
    echo "" >&2
    echo "Usage: source load_secrets [all|github|bird|mrsk|openclaw]" >&2
    echo "" >&2
    echo "Examples:" >&2
    echo "  source load_secrets all          # Load all secrets" >&2
    echo "  source load_secrets github       # Load GitHub token only" >&2
    echo "  source load_secrets bird         # Load Twitter/Bird credentials" >&2
    echo "" >&2
    return 1
    ;;
esac
