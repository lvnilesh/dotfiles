#!/usr/bin/env zsh
# sync_openclaw_secrets - Sync secrets from Vaultwarden to ~/.openclaw/.env
# Usage: sync_openclaw_secrets [--dry-run]
#
# This writes OpenClaw secrets from Vaultwarden to the .env file.
# Gateway reads .env on startup - restart gateway to apply new values.

DRY_RUN=false
[[ "$1" == "--dry-run" ]] && DRY_RUN=true

OPENCLAW_ENV="$HOME/.openclaw/.env"
BACKUP_ENV="$HOME/.openclaw/.env.bak"

echo "Fetching secrets from Vaultwarden..." >&2

# Source the load_secrets functions and load secrets
source "$HOME/.dotfiles/load_secrets" 2>/dev/null
unlock_bw_if_locked || { echo "Error: Cannot unlock Bitwarden vault" >&2; exit 1; }

# Load secrets (ignore value= output from bw CLI bug)
source "$HOME/.dotfiles/load_secrets" openclaw 2>/dev/null
source "$HOME/.dotfiles/load_secrets" bird 2>/dev/null

# Verify we have the secrets
if [[ -z "$TELEGRAM_BOT_TOKEN" ]]; then
  echo "Error: Failed to load TELEGRAM_BOT_TOKEN from Vaultwarden" >&2
  exit 1
fi

echo "✓ Secrets loaded from Vaultwarden" >&2

# Read existing .env to preserve non-secret config (IPs, shade IDs, etc.)
declare -A existing_config
if [[ -f "$OPENCLAW_ENV" ]]; then
  while IFS= read -r line; do
    [[ "$line" =~ ^#.*$ || -z "$line" ]] && continue
    if [[ "$line" =~ ^([A-Z_][A-Z0-9_]*)=\"?([^\"]*)\"?$ ]]; then
      existing_config[${match[1]}]="${match[2]}"
    fi
  done < "$OPENCLAW_ENV"
fi

# Build new .env content
NEW_ENV="# OpenClaw Environment Variables
# Synced from Vaultwarden: $(date '+%Y-%m-%d %H:%M:%S')
# DO NOT commit to git - regenerate with: sync_openclaw_secrets

# === Channel Tokens (from Vaultwarden) ===
TELEGRAM_BOT_TOKEN=\"$TELEGRAM_BOT_TOKEN\"
SLACK_BOT_TOKEN=\"$SLACK_BOT_TOKEN\"
SLACK_APP_TOKEN=\"$SLACK_APP_TOKEN\"
OPENCLAW_GATEWAY_TOKEN=\"$OPENCLAW_GATEWAY_TOKEN\"

# === API Keys (from Vaultwarden) ===
GEMINI_API_KEY=\"$GEMINI_API_KEY\"
GOOGLE_PLACES_API_KEY=\"$GOOGLE_PLACES_API_KEY\"

# === Smart Home (from Vaultwarden) ===
XIAOMI_VACUUM_TOKEN=\"$XIAOMI_VACUUM_TOKEN\"
DIRIGERA_TOKEN=\"$DIRIGERA_TOKEN\"

# === Bird CLI / Twitter (from Vaultwarden) ===
AUTH_TOKEN=\"$AUTH_TOKEN\"
CT0=\"$CT0\"

# === Web Search (Brave) ===
BRAVE_API_KEY=\"$BRAVE_API_KEY\"

# === Local Config (preserved) ===
XIAOMI_VACUUM_IP=\"${existing_config[XIAOMI_VACUUM_IP]:-192.168.40.27}\"
DIRIGERA_HUB_IP=\"${existing_config[DIRIGERA_HUB_IP]:-192.168.1.38}\"

# Dirigera Shades
DIRIGERA_DEFAULT_SHADES=\"${existing_config[DIRIGERA_DEFAULT_SHADES]:-1 2 3 4 side}\"
DIRIGERA_SHADE_1_ID=\"${existing_config[DIRIGERA_SHADE_1_ID]:-41b6ae8e-0595-4b97-830c-fe0febe47de3_1}\"
DIRIGERA_SHADE_2_ID=\"${existing_config[DIRIGERA_SHADE_2_ID]:-bf8bbca6-01b7-46d0-9080-f22d12dc5db2_1}\"
DIRIGERA_SHADE_3_ID=\"${existing_config[DIRIGERA_SHADE_3_ID]:-53d47811-ac2d-451f-855a-a0e85596d6ed_1}\"
DIRIGERA_SHADE_4_ID=\"${existing_config[DIRIGERA_SHADE_4_ID]:-3572f66a-5840-4601-9fda-b8047a94d2f9_1}\"
DIRIGERA_SHADE_SIDE_ID=\"${existing_config[DIRIGERA_SHADE_SIDE_ID]:-b3ab5181-8aae-4be4-9285-6d9531564be6_1}\""

if $DRY_RUN; then
  echo "=== DRY RUN - Would write to $OPENCLAW_ENV ===" >&2
  echo "$NEW_ENV"
  exit 0
fi

# Backup existing .env
if [[ -f "$OPENCLAW_ENV" ]]; then
  cp "$OPENCLAW_ENV" "$BACKUP_ENV"
  echo "✓ Backed up existing .env to .env.bak" >&2
fi

# Write new .env
echo "$NEW_ENV" > "$OPENCLAW_ENV"
chmod 600 "$OPENCLAW_ENV"

echo "✓ Wrote secrets to $OPENCLAW_ENV" >&2
echo "" >&2
echo "Secrets synced. Restart gateway to apply:" >&2
echo "  launchctl kickstart -k gui/\$(id -u)/ai.openclaw.gateway" >&2
