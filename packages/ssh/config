# Read more about SSH config files: https://linux.die.net/man/5/ssh_config

# This needs to be at the beginning of this file.
Host 192.168.1.* *.cg.home.arpa
  StrictHostKeyChecking off
  UserKnownHostsFile=/dev/null

# This matches any hostname without a dot.
Host * !*.*
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null

Host *
  UseKeychain yes
  AddKeysToAgent yes
  KeepAlive yes
  ServerAliveInterval 60
  StrictHostKeyChecking ask
  Include *.cg.home.arpa
  ForwardAgent yes

Host rpi.cg.home.arpa
  User eeshan

Host azure
  HostName azure-ip-goes-here
  User cloudgenius

Host asus.cg.home.arpa
Host venus.cg.home.arpa
Host msi.cg.home.arpa
Host nuc.cg.home.arpa
Host cosmos.cg.home.arpa
Host m1.cg.home.arpa
Host macbookpro.cg.home.arpa
Host chromebox.cg.home.arpa
Host mini.cg.home.arpa
Host imac.cg.home.arpa

Host git.imac.cloudgenius.app
  HostName git.imac.cloudgenius.app
  User git
  IdentityFile ~/.ssh/id_ed25519
  Port 222

# CloudGenius AWS
Host CloudGenius
  HostName some-aws-ip-address
  ForwardAgent yes
  User ubuntu
  StrictHostKeyChecking no
  IdentityFile ~/.ssh/CloudGenius
  LocalForward 8080 127.0.0.1:80
  LocalForward 4000 127.0.0.1:4000

Host nat
  HostName some-nat-ip-address
  ForwardAgent yes
  StrictHostKeyChecking ask
  IdentityFile ~/.ssh/id_rsa
  User ubuntu

Host app-0
  HostName internal-ip-of-app-0
  ProxyCommand ssh -q -W %h:%p nat
  ForwardAgent yes
  IdentityFile ~/.ssh/id_rsa
  User ubuntu

Host app-1
  HostName internal
  ProxyCommand ssh -q -W %h:%p nat
  ForwardAgent yes
  IdentityFile ~/.ssh/id_rsa
  User ubuntu
