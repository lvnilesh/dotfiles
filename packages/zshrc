# ~/.zshrc - Optimized modular configuration
# Last updated: January 2026

# Enable Powerlevel10k instant prompt (must be at the very top)
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# VS Code shell integration
case "${TERM_PROGRAM:-}" in
  vscode)
    if [[ -n "${VSCODE_SHELL_INTEGRATION:-}" && -f "${VSCODE_SHELL_INTEGRATION}" ]]; then
      source "${VSCODE_SHELL_INTEGRATION}"
    else
      for cli in code; do
        if command -v "$cli" >/dev/null 2>&1; then
          _vsc_shell_path="$($cli --locate-shell-integration-path zsh 2>/dev/null)"
          [[ -f "$_vsc_shell_path" ]] && source "$_vsc_shell_path" && break
        fi
      done
      unset _vsc_shell_path
    fi
    ;;
esac

# Determine dotfiles location
DOTFILES_ZSH="${HOME}/.zsh"

# Load modular configuration files
source "$DOTFILES_ZSH/path.zsh"       # PATH configuration
source "$DOTFILES_ZSH/env.zsh"        # Environment variables (non-PATH)
source "$DOTFILES_ZSH/plugins.zsh"    # Oh-My-Zsh and plugins
source "$DOTFILES_ZSH/aliases.zsh"    # Shell aliases
source "$DOTFILES_ZSH/functions.zsh"  # Custom functions
source "$DOTFILES_ZSH/lazy.zsh"       # Lazy-loaded tools (conda)
source "$DOTFILES_ZSH/completions.zsh" # Completions (must be last)

# mise - universal version manager (replaces nvm, pyenv, rbenv, sdkman)
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

# Key bindings
bindkey '^[f' forward-word
bindkey '^[b' backward-word

# Secrets are loaded from Bitwarden - run: source ~/.dotfiles/load_secrets all
# Or load specific secrets: source ~/.dotfiles/load_secrets bird
