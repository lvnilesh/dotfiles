#!/bin/bash

# Repo root for accessing captured state files
# Handle both direct execution and sourcing
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
else
  ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
fi

# Install brew dependencies.
install_brew() {
  echo "Running brew..."
  brew bundle --file=brew/Brewfile
}

# Fix grc for kubectl colorizing
fix_grc_for_kubectl() {
  # remove kubectl reference from grc
  local grc_file
  if [[ $(uname -m) == 'arm64' ]]; then
    grc_file="/opt/homebrew/etc/grc.zsh"
  else
    grc_file="/usr/local/etc/grc.zsh"
  fi

  if [[ -f "$grc_file" ]]; then
    sed -i '' '/kubectl/d' "$grc_file"
  fi
}

# Install oh-my-zsh.
install_oh-my-zsh() {
  DIR="$HOME/.oh-my-zsh"
  if [ -d "$DIR" ]; then
    echo "Existing installation found in  ${DIR}...updating oh-my-zsh."
    $ZSH/tools/upgrade.sh

	rm -rf ~/.oh-my-zsh/custom/plugins/zsh-autosuggestions
	git clone https://github.com/zsh-users/zsh-autosuggestions ~/.oh-my-zsh/custom/plugins/zsh-autosuggestions
    rm -rf ~/.oh-my-zsh/custom/plugins/zsh-syntax-highlighting
	git clone https://github.com/zsh-users/zsh-syntax-highlighting.git ~/.oh-my-zsh/custom/plugins/zsh-syntax-highlighting

    return 0;
  else
    echo "Installing oh-my-zsh..."
    # Install oh-my-zsh.
    sh -c "$(curl -fsSL https://raw.github.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
    git clone https://github.com/zsh-users/zsh-autosuggestions ~/.oh-my-zsh/custom/plugins/zsh-autosuggestions
    git clone https://github.com/zsh-users/zsh-syntax-highlighting.git ~/.oh-my-zsh/custom/plugins/zsh-syntax-highlighting
    return 0;
  fi
}

# Install powerlevel10k.
install_powerlevel10k() {
  DIR="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/themes/powerlevel10k"
  if [ -d "$DIR" ]; then
    echo "Existing installation found in  ${DIR}...updating p10k via a git pull."
    git -C ${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/themes/powerlevel10k pull
    return 0;
  else
    echo "Installing powerlevel10k..."
    # Install powerlevel10k.
    git clone --depth=1 https://github.com/romkatv/powerlevel10k.git ${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/themes/powerlevel10k
    return 0;
  fi
}

# Setup rc files.
symlink_dotfiles() {
  echo "Symlinking dotfiles..."
  rcup -fvd packages -x zsh | nl -bn
}

# Configure VS code fonts and extensions.
configure_vscode() {
  echo "Applying Cloud Genius VS Code style..."

  # Fix Gatekeeper blocking VS Code on fresh installs
  if [ -d "/Applications/Visual Studio Code.app" ]; then
    echo "Removing quarantine attribute and bypassing Gatekeeper for VS Code..."
    # Remove quarantine attribute (use sudo for fresh installs)
    sudo xattr -dr com.apple.quarantine "/Applications/Visual Studio Code.app"
    # Disable Gatekeeper assessment for this app
    sudo spctl --add --label "Approved" "/Applications/Visual Studio Code.app"
    sudo spctl --enable --label "Approved"
    # Re-sign to fix code signature validation error (-67062)
    sudo codesign --force --deep --sign - "/Applications/Visual Studio Code.app"
  fi

  if [[ `uname -m` == 'arm64' ]]
  then
    ln -sf "/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code" /opt/homebrew/bin/code
  else
    ln -sf "/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code" /usr/local/bin/code
  fi



  # Install VS Code extensions from captured list if available
  if command -v code >/dev/null 2>&1 && [ -f "$ROOT_DIR/vscode/extensions.txt" ]; then
    while IFS= read -r ext; do
      [[ -n "$ext" ]] && code --install-extension "$ext" || true
    done < "$ROOT_DIR/vscode/extensions.txt"
  fi


  cd ~/Library/Fonts && {
    rm -rf MesloLGS*.ttf
    wget "https://cloudgeniuscode.s3-us-west-2.amazonaws.com/MesloLGS NF Regular.ttf"
    wget "https://cloudgeniuscode.s3-us-west-2.amazonaws.com/MesloLGS NF Italic.ttf"
    wget "https://cloudgeniuscode.s3-us-west-2.amazonaws.com/MesloLGS NF Bold.ttf"
    wget "https://cloudgeniuscode.s3-us-west-2.amazonaws.com/MesloLGS NF Bold Italic.ttf"
    cd -;
  }

  rm -rf settings.json
  curl -O https://s3-us-west-2.amazonaws.com/cloudgeniuscode/settings.json
  mv -f settings.json "$HOME/Library/Application Support/Code/User/"

  # Ensure shell integration is enabled globally (improves command detection)
  # Applies to VS Code user settings, merging keys with jq
  local CODE_USER_DIR="$HOME/Library/Application Support/Code/User"
  local SETTINGS_KEYS='.
    | ."terminal.integrated.shellIntegration.enabled" = true
    | ."terminal.integrated.shellIntegration.decorationsEnabled" = "both"
    | ."terminal.integrated.defaultProfile.osx" = "zsh"
    | ."workbench.editor.tabCloseButton" = "left"'

  ensure_settings() {
    local target_dir="$1"; local file="$target_dir/settings.json"
    mkdir -p "$target_dir"
    [ -f "$file" ] || echo '{}' > "$file"
    local tmp
    tmp=$(mktemp)
    jq "$SETTINGS_KEYS" "$file" > "$tmp" && mv "$tmp" "$file"
  }

  if command -v jq >/dev/null 2>&1; then
    ensure_settings "$CODE_USER_DIR" || true
  else
    echo "jq not found; skipping automatic VS Code settings merge."
  fi

# scripts/set-terminal-font
}

# Install Mac App Store apps from captured list (mas/installed.txt)
apply_mas_apps() {
  [ -f "$ROOT_DIR/mas/installed.txt" ] || { echo "No MAS list found; skipping"; return 0; }
  command -v mas >/dev/null 2>&1 || { echo "mas not installed; skipping"; return 0; }
  echo "Installing Mac App Store apps from captured list..."
  awk 'NF{print $1}' "$ROOT_DIR/mas/installed.txt" | grep -E '^[0-9]+$' | while read -r appid; do
    mas install "$appid" || true
  done
}

# Import macOS defaults from captured plists (macos/defaults_dump/*.plist)
apply_macos_defaults_dump() {
  local dump_dir="$ROOT_DIR/macos/defaults_dump"
  [ -d "$dump_dir" ] || { echo "No defaults dump found; skipping"; return 0; }
  echo "Importing macOS defaults from captured plists..."
  for plist in "$dump_dir"/*.plist; do
    [ -f "$plist" ] || continue
    domain="$(basename "$plist" .plist)"
    # Lint first; skip if malformed
    if plutil -lint "$plist" >/dev/null; then
      defaults import "$domain" "$plist" || true
    else
      echo "Skipping malformed plist: $plist"
    fi
  done
  # Restart relevant agents
  killall Dock 2>/dev/null || true
  killall Finder 2>/dev/null || true
  killall SystemUIServer 2>/dev/null || true
}

# Apply Finder sidebar from captured file (macos/sidebar.txt) using mysides
apply_finder_sidebar_dump() {
  local side_file="$ROOT_DIR/macos/sidebar.txt"
  command -v mysides >/dev/null 2>&1 || { echo "mysides not installed; skipping sidebar"; return 0; }
  [ -f "$side_file" ] || { echo "No sidebar dump found; skipping"; return 0; }
  # Skip if sidebar file is empty
  [ -s "$side_file" ] || { echo "Sidebar file is empty; skipping"; return 0; }
  echo "Applying Finder sidebar items..."
  # Remove existing (suppress mysides errors, handle crashes gracefully)
  local existing_items
  existing_items=$(mysides list 2>/dev/null | awk -F ' -> ' '{print $1}') || true
  echo "$existing_items" | while read -r name; do
    [ -n "$name" ] && mysides remove "$name" 2>/dev/null || true
  done
  # Add captured items from sidebar.txt
  while IFS= read -r line || [ -n "$line" ]; do
    [ -z "$line" ] && continue
    name="${line%% -> *}"; url="${line#* -> }"
    if [ -n "$name" ] && [ -n "$url" ]; then
      echo "  Adding: $name"
      mysides add "$name" "$url" 2>/dev/null || echo "  Failed to add: $name"
    fi
  done < "$side_file"
  killall Finder 2>/dev/null || true
}


# Install and configure mise (replaces nvm, pyenv, rbenv, sdkman)
setup_mise() {
  echo "Setting up mise for version management..."

  if ! command -v mise >/dev/null 2>&1; then
    echo "mise not found - install via 'brew install mise'"
    return 1
  fi

  # Symlink mise config from dotfiles
  mkdir -p "$HOME/.config/mise"
  ln -sf "$ROOT_DIR/packages/mise/config.toml" "$HOME/.config/mise/config.toml"

  # Install tool versions from config
  mise install

  echo "mise configured with tools from packages/mise/config.toml"
}

# Symlink zsh modules directory for modular zshrc
symlink_zsh_modules() {
  echo "Symlinking zsh modules..."
  # Use -n to prevent creating symlink inside existing symlink target
  ln -sfn "$ROOT_DIR/packages/zsh" "$HOME/.zsh"
}


# set obsidian cron
set_obsidian_cron() {

    # https://medium.com/analytics-vidhya/how-i-put-my-mind-under-version-control-24caea37b8a5
    # https://osxdaily.com/2020/04/27/fix-cron-permissions-macos-full-disk-access/
    # https://gist.github.com/tallguyjenks/ca3339b8b5353159f631836268e3f791

    mkdir -p ~/.local/bin
    echo "placing obsidian_sync in ~/.local/bin"
    cp scripts/obsidian_sync ~/.local/bin

    if [[ $(crontab -l | egrep -v "^(#|$)" | grep -q '/Users/cloudgenius/.local/bin/obsidian_sync'; echo $?) == 1 ]]
    then
        echo "setting crontab for obsidian"
        set -f
  echo "$(crontab -l ; echo '*/30 * * * * /Users/cloudgenius/.local/bin/obsidian_sync >/dev/null 2>&1')" | crontab -
        set +f
    else
        echo "crontab is already set for obsidian"
    fi
}

# example ssh config
install_sshconfig_example() {
echo "adding example ssh config"
rm -rf ~/.ssh/config.example
tee -a ~/.ssh/config.example  << END
Host jumpbox
HostName 52.25.136.2
ForwardAgent yes
StrictHostKeyChecking ask
IdentityFile ~/.ssh/id_rsa
User ec2-user

Host 10.0.10.251
ProxyCommand ssh -q -W %h:%p jumpbox
ForwardAgent yes
IdentityFile ~/.ssh/id_rsa
User ubuntu
END
}

# Configure macOS defaults.
configure_macos() {
  echo "Applying macOS defaults..."
  source macos/defaults
}

# Configure duti default file handlers.
configure_duti() {
  echo "Applying duti defaults..."

  if ! command -v duti &>/dev/null; then
    echo "duti not installed; skipping"
    return
  fi

  # VS Code
  local vsCodeExtensions=(json md py sh yaml yml)
  for extension in "${vsCodeExtensions[@]}"
  do
    duti -s com.microsoft.VSCode .${extension} all
  done

  # The Unarchiver
  local unarchiverExtensions=(zip rar)
  for extension in "${unarchiverExtensions[@]}"
  do
    duti -s com.macpaw.site.theunarchiver .${extension} all
  done
}

# Configure kubie defaults.
configure_kubie() {
  echo "Applying kubie defaults..."

  # Only run gcloud if installed
  if command -v gcloud &>/dev/null; then
    gcloud components install kubectl -q
  fi

  if [[ $(uname -m) == 'arm64' ]]; then
    sudo rm -rf /usr/local/bin
    sudo ln -s /opt/homebrew/bin /usr/local/bin
    local kubectl_src="/opt/homebrew/Caskroom/google-cloud-sdk/latest/google-cloud-sdk/bin/kubectl"
    if [[ -f "$kubectl_src" ]] && [[ ! -f '/opt/homebrew/bin/kubectl' ]]; then
      ln "$kubectl_src" /opt/homebrew/bin
    fi
  else
    local kubectl_src="/usr/local/Caskroom/google-cloud-sdk/latest/google-cloud-sdk/bin/kubectl"
    if [[ -f "$kubectl_src" ]] && [[ ! -f '/usr/local/bin/kubectl' ]]; then
      ln "$kubectl_src" /usr/local/bin/kubectl
    fi
  fi

  mkdir -p ~/.kube
  [[ -f macos/kubie.yaml ]] && cp macos/kubie.yaml ~/.kube/kubie.yaml
}

configure_wezterm() {
	ln -sf /Users/cloudgenius/.dotfiles/macos/.wezterm.lua ~/.wezterm.lua
}

configure_sleep_wake_computers() {
	mkdir -p ~/.local/bin
	ln -sf /Users/cloudgenius/btsync/site/atem-streamdeck-companion/sleep.sh  ~/.local/bin/soja
	ln -sf /Users/cloudgenius/btsync/site/atem-streamdeck-companion/wakeup.sh  ~/.local/bin/utho
}

# setup_zsh_autoload_functions
setup_zsh_autoload_functions() {
  echo "setting up zsh_autoload_functions..."
  mkdir -p ~/.zsh_autoload_functions
  cp -f load_secrets ~/.zsh_autoload_functions
}

# Run all setup functions
run_all() {
install_brew
fix_grc_for_kubectl
install_oh-my-zsh
install_powerlevel10k
symlink_dotfiles
symlink_zsh_modules
configure_sleep_wake_computers
setup_mise
# set_obsidian_cron
install_sshconfig_example
configure_vscode
configure_macos
configure_duti
configure_kubie
configure_wezterm
setup_zsh_autoload_functions
apply_mas_apps
apply_macos_defaults_dump
apply_finder_sidebar_dump
}

# Main: run specific function if passed as argument, otherwise run all
if [[ $# -gt 0 ]]; then
  # Run specific function(s) passed as arguments
  for func in "$@"; do
    if declare -f "$func" > /dev/null; then
      echo "Running: $func"
      "$func"
    else
      echo "Unknown function: $func"
      exit 1
    fi
  done
else
  # Run full setup
  run_all
fi
